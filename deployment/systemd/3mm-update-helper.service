[Unit]
Description=3mm privileged immutable update scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=3mm
WorkingDirectory=/opt/3mm/current
Environment=PYTHONPATH=/opt/3mm/current
ExecStart=/opt/3mm/current/.venv/bin/python -m three_mm_runtime.update_helper --socket /run/3mm/update-helper.sock --stage-root /var/lib/3mm/core/update-staging --state-root /var/lib/3mm/update-helper --allowlist /opt/3mm/current/deployment/update-dependency-allowlist.json --repository ldobranov/3mm --manifest-asset 3mm-update-manifest.json --group 3mm
Restart=on-failure
RestartSec=5s
RuntimeDirectory=3mm
RuntimeDirectoryMode=0750
StateDirectory=3mm/update-helper
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
