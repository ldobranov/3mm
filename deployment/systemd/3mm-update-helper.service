[Unit]
Description=3mm privileged update and network recovery scheduler
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=3mm
WorkingDirectory=/opt/3mm/current
Environment=PYTHONPATH=/opt/3mm/current
EnvironmentFile=-/etc/3mm/3mm.env
ExecStartPre=/opt/3mm/current/.venv/bin/python -m three_mm_provisioning.recovery_access_point recover
ExecStart=/opt/3mm/current/.venv/bin/python -m three_mm_runtime.update_helper --socket /run/3mm/update-helper.sock --stage-root /var/lib/3mm/core/update-staging --state-root /var/lib/3mm/update-helper --allowlist /opt/3mm/current/deployment/update-dependency-allowlist.json --repository ldobranov/3mm --manifest-asset 3mm-update-manifest.json --group 3mm --network-recovery-policy /var/lib/3mm/core/network-recovery-policy.json --provisioning-data-dir /var/lib/3mm/provisioning --backup-root /var/lib/3mm/backups --application-upload-root /var/lib/3mm/core/uploads/modules --application-root /var/lib/3mm/application-extensions --application-key-root /etc/3mm/application-extensions
Restart=on-failure
RestartSec=5s
RuntimeDirectory=3mm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=3mm/update-helper 3mm-setup-helper 3mm-application-host-updates
StateDirectoryMode=0750
NoNewPrivileges=true
# Retain only the UID-switch capability across hardened helper exec. Migration
# children drop UID/GID/groups and inherit no effective or ambient capabilities.
AmbientCapabilities=CAP_SETUID
PrivateTmp=true
ProtectSystem=strict
# Application-host binaries/default stay immutable; only per-instance pointers
# and the root-owned StateDirectory journal may change during lifecycle work.
ReadWritePaths=-/opt/3mm-application-hosts/instances /var/lib/3mm/backups /var/lib/3mm/core/backup-imports /var/lib/3mm/application-extensions /etc/3mm/application-extensions /run/lock /var/lib/3mm/provisioning /etc/NetworkManager/dnsmasq-shared.d
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
