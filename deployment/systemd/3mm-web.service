[Unit]
Description=3mm static web interface
After=network.target
Conflicts=3mm-setup.service

[Service]
Type=simple
User=3mm
Group=3mm
WorkingDirectory=/opt/3mm/current
EnvironmentFile=-/etc/3mm/3mm.env
ExecStart=/opt/3mm/venv/bin/python -m three_mm_web --host 0.0.0.0 --port 8080 --directory /opt/3mm/current/frontend/dist
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
RuntimeDirectory=3mm
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
