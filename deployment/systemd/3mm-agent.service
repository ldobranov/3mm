[Unit]
Description=3mm device Agent
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=3
Conflicts=3mm-setup.service

[Service]
OOMScoreAdjust=300
Type=simple
User=3mm
Group=3mm
SupplementaryGroups=gpio
WorkingDirectory=/opt/3mm-agent/current
EnvironmentFile=-/etc/3mm-agent/agent.env
ExecStart=/opt/3mm-agent/current/.venv/bin/python -I /opt/3mm-agent/current/service.pyz --host 127.0.0.1 --port 8890 --data-dir /var/lib/3mm/agent --provisioning-data-dir /var/lib/3mm/provisioning --hardware-profile native
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=3mm/agent 3mm/provisioning
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/var/lib/3mm/core -/etc/3mm/application-extensions
MemoryMax=256M
TasksMax=64
LimitNOFILE=256
CPUQuota=100%

[Install]
WantedBy=multi-user.target
