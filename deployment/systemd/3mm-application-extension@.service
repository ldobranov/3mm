[Unit]
Description=3mm supervised application extension %i
After=3mm-core.service
PartOf=3mm-core.service

[Service]
Type=simple
User=3mm-app
Group=3mm-app
WorkingDirectory=/opt/3mm/current
ExecStart=/opt/3mm/current/.venv/bin/python -m three_mm_runtime.application_host --instance %i --root /var/lib/3mm/application-extensions --key-root /etc/3mm/application-extensions --group 3mm-app
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ReadWritePaths=/var/lib/3mm/application-extensions/%i/data /var/lib/3mm/application-extensions/%i/run
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
