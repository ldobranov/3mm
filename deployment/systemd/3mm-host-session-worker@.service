[Unit]
Description=3mm reviewed unprivileged host-account session worker
PartOf=3mm-core.service
BindsTo=3mm-core.service
After=3mm-core.service

[Service]
OOMScoreAdjust=300
Type=exec
User=3mm-terminal
Group=3mm-terminal
WorkingDirectory=/var/lib/3mm-terminal
ExecStart=/opt/3mm-host-session-worker/current/.venv/bin/python -I /opt/3mm-host-session-worker/current/service.pyz
Environment=THREE_MM_SESSION_PROFILE=host_account_session_v1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/3mm-terminal
StandardInput=socket
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/3mm-terminal
InaccessiblePaths=-/etc/3mm -/var/lib/3mm -/run/3mm -/run/3mm-public-web -/run/3mm-sessions -/run/dbus -/run/systemd/private -/root
TemporaryFileSystem=/tmp:rw,nosuid,nodev,size=64M,mode=1777 /var/tmp:rw,nosuid,nodev,size=16M,mode=1777
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
LimitNOFILE=64
LimitFSIZE=16M
MemoryMax=128M
TasksMax=16
CPUQuota=50%
RuntimeMaxSec=900
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
Restart=no
