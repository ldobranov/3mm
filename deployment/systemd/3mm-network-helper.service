[Unit]
Description=3mm privileged NetworkManager helper
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
User=root
Group=3mm
WorkingDirectory=/opt/3mm/current
Environment=PYTHONPATH=/opt/3mm/current
ExecStart=/opt/3mm/current/.venv/bin/python -m three_mm_provisioning.network_helper --socket /run/3mm/network-helper.sock --group 3mm
Restart=on-failure
RestartSec=5s
RuntimeDirectory=3mm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
