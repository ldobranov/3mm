[Unit]
Description=3mm Core API
After=network.target
Conflicts=3mm-setup.service

[Service]
Type=simple
User=3mm
Group=3mm
SupplementaryGroups=3mm-app 3mm-public 3mm-platform
WorkingDirectory=/opt/3mm/current
EnvironmentFile=-/etc/3mm/3mm.env
Environment=BACKEND_EXTENSIONS_DIR=/var/lib/3mm/core/extensions/backend
Environment=FRONTEND_EXTENSIONS_DIR=/var/lib/3mm/core/extensions/frontend
Environment=COMPILED_UI_ARTIFACTS_DIR=/var/lib/3mm/core/extensions/compiled
Environment=THREE_MM_APPLICATION_ROOT=/var/lib/3mm/application-extensions
Environment=THREE_MM_APPLICATION_KEY_ROOT=/etc/3mm/application-extensions
Environment=THREE_MM_CORE_AUTHORITY_SOCKET=/run/3mm-core-authority/authority.sock
Environment=THREE_MM_PLATFORM_RUNTIME_USER=3mm-platform
Environment=THREE_MM_PLATFORM_RUNTIME_SOCKET=/run/3mm-platform/runtime.sock
ExecStart=/opt/3mm/current/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8887 --ws websockets-sansio --ws-max-size 65536 --ws-max-queue 4 --ws-per-message-deflate false
OOMScoreAdjust=-500
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=3mm/core
RuntimeDirectory=3mm-core-authority
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/3mm/backups/exports /var/lib/3mm/provisioning
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
