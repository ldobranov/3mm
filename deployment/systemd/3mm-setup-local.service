[Unit]
Description=3mm protected setup and recovery portal
After=network.target

[Service]
Type=simple
User=3mm
Group=3mm
WorkingDirectory=/opt/3mm/current
EnvironmentFile=-/etc/3mm/3mm.env
ExecStart=/opt/3mm/current/.venv/bin/python -m setup_service --host 0.0.0.0 --port 8895 --recovery-captive-port 80 --network-helper-socket /run/3mm/network-helper.sock --data-dir /var/lib/3mm/provisioning
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=3mm/provisioning
ReadWritePaths=-/var/lib/3mm/core
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
