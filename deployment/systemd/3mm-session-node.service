[Unit]
Description=3mm optional paired Node session executor
After=network.target 3mm-session-worker-node.socket
Requires=3mm-session-worker-node.socket

[Service]
Type=simple
User=3mm
Group=3mm
WorkingDirectory=/opt/3mm-session-node/current
ExecStart=/opt/3mm-session-node/current/.venv/bin/python -I /opt/3mm-session-node/current/service.pyz
RuntimeDirectory=3mm-session-node
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/3mm/agent
InaccessiblePaths=-/var/lib/3mm/core -/etc/3mm/application-extensions -/run/3mm -/run/dbus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=96M
TasksMax=16
LimitNOFILE=64
CPUQuota=50%
OOMScoreAdjust=300
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
