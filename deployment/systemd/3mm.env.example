# Optional non-secret service overrides.
DATABASE_URL=sqlite:////var/lib/3mm/core/3mm.db
UPLOADS_DIR=/var/lib/3mm/core/uploads
BACKEND_EXTENSIONS_DIR=/var/lib/3mm/core/extensions/backend
FRONTEND_EXTENSIONS_DIR=/var/lib/3mm/core/extensions/frontend
COMPILED_UI_ARTIFACTS_DIR=/var/lib/3mm/core/extensions/compiled
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8887
CORS_ORIGINS=[]
FRONTEND_URL=http://localhost:8080
DEVICE_OFFLINE_AFTER_SECONDS=90
THREE_MM_AGENT_HOST=127.0.0.1
THREE_MM_AGENT_PORT=8890
THREE_MM_AGENT_DATA_DIR=/var/lib/3mm/agent
THREE_MM_AGENT_ROLE=node
THREE_MM_AGENT_HARDWARE_PROFILE=native
THREE_MM_PROVISIONING_DATA_DIR=/var/lib/3mm/provisioning
THREE_MM_SETUP_HOST=127.0.0.1
THREE_MM_SETUP_PORT=8895
THREE_MM_UPDATE_REPOSITORY=ldobranov/3mm
THREE_MM_UPDATE_MANIFEST_ASSET=3mm-update-manifest.json
THREE_MM_UPDATE_STAGING_DIR=/var/lib/3mm/core/update-staging
THREE_MM_UPDATE_DEPENDENCY_ALLOWLIST=/opt/3mm/current/deployment/update-dependency-allowlist.json
THREE_MM_UPDATE_HELPER_SOCKET=/run/3mm/update-helper.sock
THREE_MM_UPDATE_HELPER_STATUS_FILE=/var/lib/3mm/update-helper/status.json
THREE_MM_UPDATE_POLICY_FILE=/var/lib/3mm/core/update-policy.json
THREE_MM_UPDATE_CHECK_CACHE_FILE=/var/lib/3mm/core/update-check-cache.json
THREE_MM_UPDATE_APPROVAL_TTL_SECONDS=1800
THREE_MM_BACKUP_HOST_CONFIG_FILE=/etc/3mm/3mm.env
THREE_MM_BACKUP_STORAGE_DIR=/var/lib/3mm/backups
THREE_MM_BACKUP_IMPORT_DIR=/var/lib/3mm/core/backup-imports
THREE_MM_BACKUP_MINIMUM_FREE_BYTES=67108864
THREE_MM_BACKUP_MAX_IMPORT_BYTES=537919488
