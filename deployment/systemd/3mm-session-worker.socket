[Unit]
Description=3mm local isolated session admission socket
PartOf=3mm-core.service
Before=3mm-core.service

[Socket]
ListenStream=/run/3mm-sessions/provider.sock
SocketUser=root
SocketGroup=3mm
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=3mm-core.service
