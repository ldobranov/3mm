[Unit]
Description=3mm minimal Node network recovery monitor
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=3mm
WorkingDirectory=/opt/3mm/current
Environment=PYTHONPATH=/opt/3mm/current
ExecStart=/opt/3mm/current/.venv/bin/python -m three_mm_runtime.node_recovery
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
