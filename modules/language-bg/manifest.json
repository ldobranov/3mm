{
  "manifest_version": 2,
  "module_id": "org.3mm.language.bg",
  "name": "Bulgarian language pack",
  "version": "1.0.0",
  "description": "Bulgarian translations for the Core administration UI",
  "runtimes": [
    "ui"
  ],
  "entrypoints": {
    "ui": "language-extension.json"
  },
  "compatibility": {
    "protocol": "1.0",
    "architectures": [
      "any"
    ]
  },
  "health_check": {
    "type": "json_file",
    "path": "language-extension.json"
  }
}
