# Optional local overrides. Copy to .env and load it in your shell or service.
DATABASE_URL=sqlite:///backend/data/3mm.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8887
FRONTEND_BACKEND_URL=http://localhost:8887
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DEVICE_OFFLINE_AFTER_SECONDS=90

# Read-only GitHub release catalog. No token is needed for the public repository.
THREE_MM_UPDATE_REPOSITORY=ldobranov/3mm
THREE_MM_UPDATE_MANIFEST_ASSET=3mm-update-manifest.json
THREE_MM_UPDATE_TIMEOUT_SECONDS=8
THREE_MM_UPDATE_STAGING_DIR=.runtime/update-staging
THREE_MM_UPDATE_DEPENDENCY_ALLOWLIST=deployment/update-dependency-allowlist.json
THREE_MM_UPDATE_HELPER_SOCKET=/run/3mm/update-helper.sock
THREE_MM_UPDATE_HELPER_STATUS_FILE=.runtime/update-status.json
THREE_MM_UPDATE_APPROVAL_TTL_SECONDS=1800
THREE_MM_UPDATE_MAX_ARTIFACT_BYTES=536870912
THREE_MM_UPDATE_MINIMUM_FREE_BYTES=536870912

# AI providers are optional. Never commit real values.
GROQ_API_KEY=
OPENROUTER_API_KEY=

