{
  "extends": "./node_modules/@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@/extensions/*": ["src/extensions/*"],
      "vue": ["./node_modules/vue/dist/vue.d.ts"],
      "@3mm/application-ui/v1": ["./src/extension-ui/application-v1.ts"],
      "@3mm/ui/v1": ["./src/extension-ui/v1.ts"]
    },
    "typeRoots": ["./node_modules/@types", "./src/extensions"]
  }
}
